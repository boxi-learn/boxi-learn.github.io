---
import Base from "../../../layouts/Base.astro";
import { type Lang, LANGS, SUBJECTS, STAGES, MATH_URL, t } from "../../../data/site";

export function getStaticPaths() {
  return LANGS.flatMap((lang) => STAGES.map((st) => ({ params: { lang, n: String(st.n) } })));
}
const lang = Astro.params.lang as Lang;
const st = STAGES[Number(Astro.params.n)];
const here = SUBJECTS.filter((s) => s.stages.includes(st.n));
---

<Base lang={lang} title={`${t("stage", lang)} ${st.n} · ${st.name[lang]}`} description={st.theme[lang]} path={`stage/${st.n}/`}>
  <section class="hero">
    <p class="eyebrow">{t("stage", lang)} {st.n} · {st.age[lang]}</p>
    <h1>{st.name[lang]}</h1>
    <p class="lead">{st.theme[lang]}</p>
    <p class="rule">{st.form[lang]}</p>
  </section>
  <h2>{t("allStage", lang)}</h2>
  <p class="meta"><a href={`${MATH_URL}/${lang}/stages/${st.n}/`}>{t("math", lang)} ↗</a></p>
  {here.map((s) => {
    const lessons = s.lessons.filter((l) => l.stage === st.n);
    return (
      <div class={`stage-row s-${s.id}`}>
        <span class="stage-num">{s.name[lang].slice(0, 1)}</span>
        <div>
          <h3><a class="accent" href={`/${lang}/${s.id}/`}>{s.name[lang]}</a></h3>
          <div class="q">{s.stage_questions[String(st.n)]?.[lang]}</div>
          {lessons.length === 0 ? <p class="meta">{t("noLessons", lang)}</p> : (
            <ul class="lessons">
              {lessons.map((l) => (
                <li>
                  <a class="lesson" href={`/${lang}/${s.id}/${l.slug}/`}>
                    <span class="title">{l.title[lang]}</span>
                    <span class="sub">{l.insight[lang]}</span>
                    <span class={`badge ${l.status}`}>{t(l.status, lang)}</span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    );
  })}
</Base>
